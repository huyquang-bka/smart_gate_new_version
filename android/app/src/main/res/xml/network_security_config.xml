<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- SECURITY (#31901): removed <certificates src="user" /> so the app
                 does NOT trust user-installed CAs (prevents user-added MITM certs). -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">smartgate.htit.com.vn</domain>
    </domain-config>
</network-security-config> 